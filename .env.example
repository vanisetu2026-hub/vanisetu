# ========================================================
# VANISETU — Environment Variables Configuration
# ========================================================

# CLIENT (Frontend - Vite)
# --------------------------------------------------------
# Replace with your Firebase Project Configuration
VITE_FIREBASE_API_KEY=AIzaSyYourActualFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional Backend API URL (defaults to proxy /api in development)
VITE_API_URL=http://localhost:5000/api


# SERVER (Backend - Express.js)
# --------------------------------------------------------
PORT=5000
NODE_ENV=development

# Firebase Admin SDK Configuration (Optional in development)
# For local or development mode, VANISETU includes a full in-memory
# fallback store when Firebase Admin keys are omitted.
FIREBASE_PROJECT_ID=your-project-id
# Single line JSON string of service account key, or path in GOOGLE_APPLICATION_CREDENTIALS:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
