# ========================================================
# VANISETU — Client Environment Configuration
# ========================================================

# Firebase Client SDK Configuration
# (Found in Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=AIzaSyYourActualFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=vanisetu-5b548.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vanisetu-5b548
VITE_FIREBASE_STORAGE_BUCKET=vanisetu-5b548.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Backend API URL
# In development, Vite automatically proxies /api to http://localhost:5000.
# For production, set this to your deployed backend URL (e.g. https://api.vanisetu.org/api)
# or leave unset to use relative /api proxy.
VITE_API_BASE_URL=
