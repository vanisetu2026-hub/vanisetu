rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user owns the document by matching uid
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user is authenticated as an admin / staff member
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@vanisetu\\.org') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'content_admin', 'language_reviewer', 'moderator'])
      );
    }
    
    // User Profiles Collection:
    // Any authenticated learner can read user stats (for leaderboard/community)
    // Users can create and edit their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Learning Progress & Streaks:
    // Strictly limited to the owner
    match /userProgress/{progressId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || progressId == request.auth.uid);
      allow write: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || progressId == request.auth.uid);
    }
    
    // User Achievements:
    match /userAchievements/{achievementDocId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    
    // Tribal Curriculum: Languages, Courses, Lessons, Exercises, Vocabulary, System Achievements
    // Public read-only for all learners (both authenticated & guest)
    // Authenticated users/admins can write (enables 1-click seeding & admin CMS)
    match /languages/{languageId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /vocabulary/{vocabularyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Community Contributions (Oral traditions, folklore, folk songs):
    // Anyone can read approved content; authenticated users can read their own submissions
    // Authenticated users can submit new stories and increment likes
    match /communityContributions/{contributionId} {
      allow read: if resource == null || resource.data.moderationStatus == 'approved' || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
